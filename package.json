{
  "name": "@cycjimmy/h5-audio-controls",
  "type": "module",
  "version": "6.0.0",
  "description": "Simple h5 music controller",
  "browser": "dist/h5-audio-controls.umd.min.js",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/h5-audio-controls#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycjimmy/h5-audio-controls.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/h5-audio-controls/issues"
  },
  "keywords": [
    "h5",
    "audio",
    "control"
  ],
  "exports": {
    ".": {
      "import": "./dist/h5-audio-controls.esm.js",
      "default": "./dist/h5-audio-controls.esm.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/h5-audio-controls.esm.js",
  "module": "dist/h5-audio-controls.esm.js",
  "scripts": {
    "start": "npm run dev",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --color --forceExit --detectOpenHandles",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --color --forceExit --detectOpenHandles --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.{css,scss}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "dev": "vite",
    "build": "trash dist && npm run build:esm && npm run build:umd && npm run build:umd:min",
    "build:esm": "vite build --mode esm",
    "build:umd": "vite build --mode umd",
    "build:umd:min": "vite build --mode umd-min",
    "build:deployment": "vite build --mode deployment && node tasks/copyPublishFiles.js",
    "package": "trash .release && npm run build && node tasks/copyFiles.js && node tasks/handlePackageJson.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cycjimmy/awesome-js-funcs": "^5.0.0",
    "@cycjimmy/sass-lib": "^5.0.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@cycjimmy/config-lib": "^3.2.1",
    "autoprefixer": "^10.4.19",
    "babel-jest": "^30.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "fs-extra": "^11.2.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.3.0",
    "sass": "^1.106.0",
    "stylelint": "^17.16.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "terser": "^5.51.2",
    "trash-cli": "^7.2.0",
    "vite": "^8.3.5"
  }
}
